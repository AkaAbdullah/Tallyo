# MongoDB connection string. Leave empty in development to use a throwaway in-memory database.
MONGODB_URI=

# Better Auth: a long random string (generate one with `openssl rand -base64 32`) and your app URL.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Optional: connect the Better Auth dashboard (https://dash.better-auth.com)
BETTER_AUTH_API_KEY=

# Optional social sign-in
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional AI features (https://console.groq.com/keys)
GROQ_API_KEY=
